{
	"name": "shortestpath-oj",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.0.0",
	"publisher": "shortestpath",
	"repository": {
		"type": "git",
		"url": "https://github.com/KevinHuangIsLearning/shortestpath-ide.git"
	},
	"engines": {
		"vscode": "^1.128.0"
	},
	"categories": [
		"Other"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		}
	},
	"activationEvents": [
		"onStartupFinished",
		"onUri",
		"onCommand:shortestpath.oj.openIntegratedBrowser",
		"onCommand:shortestpath.oj.openIntegratedBrowserDirect",
		"onCommand:shortestpath.oj.showProblemForCph",
		"onCommand:shortestpath.oj.submitProblem"
	],
	"main": "./out/extension.js",
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
		"compile": "npm run clean && node ../../node_modules/typescript/bin/tsc6 -p ./",
		"test": "npm run compile && node --test out/test/*.test.js",
		"vscode:prepublish": "npm run compile"
	},
	"contributes": {
		"configuration": {
			"title": "%displayName%",
			"properties": {
				"shortestpath.oj.problemSplitRatio": {
					"type": "number",
					"default": 60,
					"minimum": 10,
					"maximum": 90,
					"scope": "window",
					"description": "%configuration.problemSplitRatio%"
				},
				"shortestpath.oj.cppSubmissionLanguage": {
					"type": "string",
					"enum": [
						"ask",
						"cpp14",
						"cpp20"
					],
					"default": "ask",
					"scope": "window",
					"description": "%configuration.cppSubmissionLanguage%"
				},
				"shortestpath.oj.antiFraudReminder": {
					"type": "boolean",
					"default": false,
					"scope": "window",
					"description": "%configuration.antiFraudReminder%"
				}
			}
		},
		"commands": [
			{
				"command": "shortestpath.oj.openIntegratedBrowser",
				"title": "%command.openIntegratedBrowser%"
			},
			{
				"command": "shortestpath.oj.showProblem",
				"title": "%command.showProblem%"
			},
			{
				"command": "shortestpath.oj.openIntegratedBrowserDirect",
				"title": "%command.openIntegratedBrowserDirect%"
			}
		]
	},
	"dependencies": {
		"@vscode/markdown-it-katex": "^1.1.2",
		"katex": "^0.16.47",
		"markdown-it": "^14.3.0",
		"shiki": "^4.3.1",
		"ws": "^8.21.0"
	},
	"devDependencies": {
		"@types/markdown-it": "^14.1.2"
	}
}
